# ── Helius RPC ────────────────────────────────────────────────────────────────
# Get yours at https://helius.dev
HELIUS_API_KEY=your_helius_api_key_here

# ── Arcium MPC ────────────────────────────────────────────────────────────────
# NOTE: Only "mock" mode is implemented today. Setting ARCIUM_MXE_ID to any other
# value selects the real Arcium path, which is NOT implemented and will throw at
# verification time (see gateway/src/lib/arcium.ts). Keep ARCIUM_MXE_ID=mock until
# real integration lands. Docs: https://docs.arcium.com/developers
ARCIUM_API_KEY=your_arcium_api_key_here
ARCIUM_MXE_ID=mock

# ── Gateway wallet ────────────────────────────────────────────────────────────
# The Solana wallet that receives USDC payments
PAYMENT_WALLET_ADDRESS=your_solana_wallet_address_here

# ── Token ─────────────────────────────────────────────────────────────────────
# USDC mainnet mint — do not change unless testing on devnet
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# ── Upstream data (optional) ──────────────────────────────────────────────────
# CoinMarketCap API key for real price data. If absent, mock data is returned.
CMC_API_KEY=your_cmc_api_key_here
